{
  "_dosya": "Rusya — Ülke Dosyası · grafik künyesi",
  "_amac": "Hangi bölümde hangi grafik, hangi biçimde, hangi iki dilli etiketle çizilecek.",
  "_neden_grafik": "Bu dosyanın ilk taslağında zaman serileri TABLO olarak duruyordu ve okuma yoruyordu. Ölçüldü: şikâyet edilen bölümlerde ortalama 11,4 tablo satırı vardı, edilmeyenlerde 2,2. Ayırt edici olan sayı yoğunluğu değil tablo yüküydü — 6. bölüm en yoğun sayı oranlarından birine sahip ama sıfır tablosu olduğu için yormuyor. Zaman serisi okunacak değil BAKILACAK şeydir; tablodan grafiğe taşındı.",
  "_traceability": "Değeri '@' ile başlayan her alan data.json'a bir YOL'dur. seed_dossier.mjs bu yolları çözer; yol bulunamazsa veya sayı değilse üretim durur. Grafikteki sayı ile metindeki sayı aynı tek kaynaktan gelir.",
  "_roller": "rol alanı DossierTheme'deki renge işaret eder. Renk TEK BAŞINA anlam taşımaz; çizici her role ayrı bir biçim de verir (düz/kesikli çizgi, dolu/içi boş nokta).",

  "grafikler": {
    "ticaret_cizgi": {
      "tur": "cizgi",
      "baslik": { "tr": "Açık on iki yıldır aynı yönde", "en": "Twelve years, the same direction" },
      "birim": { "tr": "milyon $ (cari)", "en": "million $ (current)" },
      "bolen": 1000000,
      "ondalik": 0,
      "seriler": [
        { "ad": { "tr": "Rusya → Türkiye", "en": "Russia → Türkiye" }, "rol": "vurgu",
          "noktalar": { "liste": "@ikili_ticaret.seri", "x": "yil", "y": "rusyadan_turkiyeye_usd" } },
        { "ad": { "tr": "Türkiye → Rusya", "en": "Türkiye → Russia" }, "rol": "ikincil",
          "noktalar": { "liste": "@ikili_ticaret.seri", "x": "yil", "y": "turkiyeden_rusyaya_usd" } }
      ],
      "not": { "tr": "Türkiye'nin gümrük kaydı, HS 01-24.", "en": "Türkiye's customs record, HS 01-24." }
    },

    "tez_yigin": {
