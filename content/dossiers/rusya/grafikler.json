              "deger": "@tez.dayanak.rusyadan_aldigimiz_depolanabilir.tutar_usd", "rol": "vurgu" },
            { "ad": { "tr": "Diğer", "en": "Other" },
              "deger": "@tez.dayanak.rusyadan_aldigimiz_diger.tutar_usd", "rol": "sessiz" }
          ] },
        { "etiket": { "tr": "Rusya'ya sattığımız", "en": "What we sell to Russia" },
          "dilimler": [
            { "ad": { "tr": "Bozulur — meyve, balık, sebze", "en": "Perishable — fruit, fish, vegetables" },
              "deger": "@tez.dayanak.rusyaya_sattigimiz_bozulur.tutar_usd", "rol": "ikincil" },
            { "ad": { "tr": "Diğer", "en": "Other" },
              "deger": "@tez.dayanak.rusyaya_sattigimiz_diger.tutar_usd", "rol": "sessiz" }
          ] }
      ],
      "not": { "tr": "2024. Her çubuk kendi içinde yüzde yüze normalize edilir.", "en": "2024. Each bar is normalised to 100%." }
